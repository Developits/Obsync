{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "obsidian-sync-worker",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "obsidian-sync-db",
      "database_id": "4736be09-44e2-47a4-8503-be511faec993"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "obsidian-sync-blobs"
    }
  ]
}
