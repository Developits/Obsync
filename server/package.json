{
  "name": "obsidian-sync-worker",
  "version": "1.0.0",
  "type": "module",
  "description": "Cloudflare Worker backend for Distributed Obsidian Sync",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit",
    "db:init": "wrangler d1 execute obsidian-sync-db --local --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241018.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.83.0"
  }
}
